# Desenvolvimento/portfólio: o script run-demo.ps1 configura PROCUREFLOW_DEMO=1.
# Em rede, mantenha PROCUREFLOW_DEMO=false e defina um segredo forte abaixo.
PROCUREFLOW_DEMO=false
PROCUREFLOW_HOST=127.0.0.1
PORT=8090
PROCUREFLOW_ADMIN_TOKEN=troque-por-um-segredo-longo-e-unico

# Opcional: pesquisa local com SearXNG. Nunca inclua credenciais neste arquivo.
# SEARXNG_URL=http://127.0.0.1:8088
